# =============================================================================
# AVYANA CRAFT - PRODUCTION ENVIRONMENT SPECIFICATION
# =============================================================================

# Server Environment & Reverse Proxy
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://avyanacraft.com,https://*.vercel.app
# Trust proxy: 1 when behind Cloudflare / AWS ALB / Nginx / Render / Railway
TRUST_PROXY=1

# Database Connection (Neon Serverless PostgreSQL with Connection Pooling)
DATABASE_URL="postgresql://username:password@ep-divine-firefly-51610542-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARACTERS_CRYPTOGRAPHIC_SECRET_KEY"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARACTERS_CRYPTOGRAPHIC_REFRESH_KEY"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Tiered Production Rate Limiting (Requests per Window)
RATE_LIMIT_GLOBAL_MAX=1000       # Global baseline: 1,000 req / 15m per IP
RATE_LIMIT_AUTH_MAX=15           # Auth / login / signup: 15 req / 15m per IP
RATE_LIMIT_ORDER_MAX=10          # Checkout & orders: 10 orders / 10m per IP/User
RATE_LIMIT_MEDIA_MAX=30          # Media uploads: 30 presigned URLs / 15m

# Google & Firebase Authentication
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
FIREBASE_PROJECT_ID="avyana-craft"

# Cloudflare R2 Media Storage (S3 API Compatible)
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_cloudflare_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_cloudflare_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="boutique-assets"
CLOUDFLARE_R2_PUBLIC_URL="https://media.avyanacraft.com"

# Boutique Store Defaults & Direct UPI
BOUTIQUE_UPI_VPA="avyanacraft@okaxis"
BOUTIQUE_NAME="Avyana Craft"
COD_SURCHARGE_FEE=0.00
FREE_SHIPPING_THRESHOLD=1499.00

# Razorpay Online Payment Gateway (Official API Credentials)
# Test Mode: rzp_test_... | Live Mode: rzp_live_...
# Obtain from Razorpay Dashboard: Settings -> API Keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_or_live_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
